# CrackVision AI — Backend Environment Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (defaults to SQLite in backend/data)
DATABASE_URL=sqlite:///./data/crackvision.db

# Model weights path (relative to backend/ or absolute)
MODEL_WEIGHTS_PATH=app/weights/crack_yolov8s_seg.pt
DEVICE=auto  # Options: auto, cpu, cuda, mps
